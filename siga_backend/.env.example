# Copiar a .env y completar. NUNCA subir el .env real.
APP_NAME=SIGA Core
ENVIRONMENT=development
SECRET_KEY=cambiar-por-un-valor-largo-y-aleatorio
DEBUG=True

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambiar
DB_NAME=siga_suiza_2026

MODULES_AUTO_DISCOVER=True
MODULES_VALIDATE_ON_START=True

# Logging de SQL (SQLAlchemy echo). OFF por defecto: en Railway inunda los
# logs y dispara el rate limit de 500 logs/seg. Activar solo en local.
SQL_ECHO=False

# NATS: si no hay servidor (p. ej. Railway sin servicio NATS), el sistema
# funciona sin Event Bus: un único intento, sin errores en los logs.
NATS_URL=nats://localhost:4222
ENABLE_NATS=False
# Timeout (s) del intento de conexión y espera entre reintentos
NATS_CONNECT_TIMEOUT=3
NATS_RETRY_SECONDS=300
