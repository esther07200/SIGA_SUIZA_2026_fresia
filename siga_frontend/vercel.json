{
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sigasuiza2026fresia-production.up.railway.app/api/:path*"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://sigasuiza2026fresia-production.up.railway.app/api/$1"
    },
    {
      "source": "/api",
      "destination": "https://sigasuiza2026fresia-production.up.railway.app/api"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://sigasuiza2026fresia-production.up.railway.app/auth/:path*"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://sigasuiza2026fresia-production.up.railway.app/auth/$1"
    },
    {
      "source": "/auth",
      "destination": "https://sigasuiza2026fresia-production.up.railway.app/auth"
    },
    {
      "source": "/core/:path*",
      "destination": "https://sigasuiza2026fresia-production.up.railway.app/core/:path*"
    },
    {
      "source": "/core/(.*)",
      "destination": "https://sigasuiza2026fresia-production.up.railway.app/core/$1"
    },
    {
      "source": "/core",
      "destination": "https://sigasuiza2026fresia-production.up.railway.app/core"
    },
    {
      "source": "/health",
      "destination": "https://sigasuiza2026fresia-production.up.railway.app/health"
    },
    {
      "source": "/health/",
      "destination": "https://sigasuiza2026fresia-production.up.railway.app/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
